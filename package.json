{
  "name": "cc-hud",
  "version": "3.0.0",
  "description": "A customizable status line with activity tracking for Claude Code CLI",
  "module": "src/cc-hud.ts",
  "type": "module",
  "bin": {
    "cc-hud": "dist/cc-hud.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "start": "bun run src/cc-hud.ts",
    "build": "rm -rf dist/* && bun build src/cc-hud.ts --target=node --outfile=dist/cc-hud.js --target-version=14",
    "postbuild": "bun run scripts/replace-version.ts",
    "example": "cat scripts/payload.example.json | bun start",
    "prepublishOnly": "bun run build",
    "lint": "bun tsc --noEmit && eslint . --config eslint.config.js --max-warnings=0",
    "test": "bun vitest",
    "docs": "typedoc",
    "docs:clean": "rm -rf docs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "latest",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.2.17",
    "chalk": "^5.6.2",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-newlines": "^1.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "ink": "^6.8.0",
    "ink-gradient": "^3.0.0",
    "ink-select-input": "^6.2.0",
    "pluralize": "^8.0.0",
    "react": "^19.2.8",
    "react-devtools-core": "^6.1.5",
    "string-width": "^8.2.2",
    "strip-ansi": "^7.2.0",
    "tinyglobby": "^0.2.17",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7",
    "zod": "^4.4.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "esbuild": "0.28.1",
    "js-yaml": "4.3.0",
    "postcss": "8.5.23",
    "shell-quote": "1.10.0",
    "vite": "7.3.6",
    "ws": "8.21.1"
  },
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "status-line",
    "terminal"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sirmalloc/cc-hud.git"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "patchedDependencies": {
    "ink@6.2.0": "patches/ink@6.2.0.patch"
  }
}
